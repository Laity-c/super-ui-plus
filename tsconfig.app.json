{
  "extends": "@vue/tsconfig/tsconfig.dom.json",
  "compilerOptions": {
    "composite": true,
    "noEmit": false,
    "allowImportingTsExtensions": false,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",

    "types": ["vite/client", "element-plus/global"],
    "lib": ["esnext", "dom"],
    "typeRoots": [
      "./node_modules/@types",
      "./node_modules"
    ],
    "baseUrl": ".",
    "paths": {
      "@super-ui-plus/components": ["packages/components"],
      "@super-ui-plus/components/*": ["packages/components/*"],
      "@super-ui-plus/eslint-config": ["packages/eslint-config"],
      "@super-ui-plus/resolver": ["packages/resolver"],
      "@super-ui-plus/theme-chalk": ["packages/theme-chalk"],
      "@super-ui-plus/types": ["packages/types"],
      "super-ui-plus/*": ["packages/*"],
      "@vue/shared": ["./node_modules/@vue/shared"]
    },
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true
  },
  "include": [
    "packages/**/*.ts",
    "packages/**/*.tsx",
    "packages/**/*.vue",
    "play/**/*.ts",
    "play/**/*.tsx",
    "play/**/*.vue",
    "build/**/*.ts",
    "build/**/*.d.ts",
    "docs/components/**/*.vue",
    "vite.config.ts"
  ]
}